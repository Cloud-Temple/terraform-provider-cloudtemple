# COMPUTE - PUBLIC CLOUD VM (VM Instances)
# The catalogue ids/names below are resolved out-of-band on the target tenant.
PUBLIC_CLOUD_VM_AZ_ID=
PUBLIC_CLOUD_VM_AZ_NAME=

PUBLIC_CLOUD_VM_IMAGE_ID=
PUBLIC_CLOUD_VM_IMAGE_NAME=

PUBLIC_CLOUD_VM_INSTANCE_FAMILY_ID=
PUBLIC_CLOUD_VM_INSTANCE_FAMILY_NAME=

PUBLIC_CLOUD_VM_BACKUP_POLICY_ID=
PUBLIC_CLOUD_VM_BACKUP_POLICY_NAME=

# A PRIVATE BACKBONE network (no `vpc` block).
PUBLIC_CLOUD_VM_NETWORK_ID=
PUBLIC_CLOUD_VM_NETWORK_NAME=

# A VPC-BACKED network (its `vpc` block is populated), plus a FREE address inside
# that VPC private network. Required by the inline-VPC acceptance test; leave both
# empty to skip it.
PUBLIC_CLOUD_VM_VPC_NETWORK_ID=
PUBLIC_CLOUD_VM_VPC_STATIC_IP=

# COMPUTE - OPENIAAS - VPC (inline os_network_adapter static IP)
# A template with EXACTLY TWO network adapters, a VPC-backed network, and a FREE
# address in that VPC private network. Leave empty to skip the inline-VPC test.
COMPUTE_IAAS_OPENSOURCE_VPC_TEMPLATE_ID=
COMPUTE_IAAS_OPENSOURCE_VPC_NETWORK_ID=
COMPUTE_IAAS_OPENSOURCE_VPC_STATIC_IP=
# A SECOND, DIFFERENT network for the template's other adapter (the platform
# refuses one explicit address when several adapters share a network).
COMPUTE_IAAS_OPENSOURCE_VPC_SECOND_NETWORK_ID=
# A SECOND free address in the same VPC private network.
COMPUTE_IAAS_OPENSOURCE_VPC_SECOND_STATIC_IP=
# The "nobackup" SLA policy of the TEMPLATE'S machine manager (the name is not
# unique across managers; an id avoids picking the wrong homonym).
COMPUTE_IAAS_OPENSOURCE_NOBACKUP_POLICY_ID=
